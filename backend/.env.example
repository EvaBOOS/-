# AI Video Generator - Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/videogen
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/videogen

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
# true | false | leave empty for auto (Celery when DB is not sqlite and Redis is up)
USE_CELERY=

# Local SQLite (optional — skip Postgres for Windows/dev):
# DATABASE_URL=sqlite+aiosqlite:///./videogen.db
# DATABASE_URL_SYNC=sqlite:///./videogen.db
# USE_CELERY=false

# Security
ENVIRONMENT=development
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# Admin Account
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme123

# --- Hybrid AI stack ---
# Script: AITUNNEL preferred (₽, no VPN) — https://aitunnel.ru
AITUNNEL_API_KEY=sk-aitunnel-xxx
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/
AITUNNEL_MODEL=gemini-2.5-flash
# Fallback if AITUNNEL empty:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voice: ElevenLabs if available; else Edge TTS (free, works from RU)
ELEVENLABS_API_KEY=
EDGE_TTS_VOICE=ru-RU-SvetlanaNeural

# Avatar: HeyGen — https://app.heygen.com
HEYGEN_API_KEY=your-heygen-api-key
# HeyGen voice_id fallback (from GET /v2/voices) — not Edge/Azure names
HEYGEN_VOICE_ID=5f99970adadb42398bf1aeb963a3888b
HEYGEN_AVATAR_ID=Abigail_expressive_2024112501
HEYGEN_BACKGROUND_COLOR=#0B1220

# Asset library (auto stickers + fonts — no manual downloads)
ASSETS_DIR=./media/assets
STICKERS_ENABLED=true
AUTO_FONT_ENABLED=true
# Free photo key: https://www.pexels.com/api/
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Whisper STT via AITUNNEL
WHISPER_MODEL=whisper-1

# Import video by link (YouTube / Reels / TikTok …) — needs yt-dlp
LINK_INGEST_ENABLED=true
# Optional self-hosted Cobalt API (tried first when set); else yt-dlp
COBALT_API_URL=
COBALT_API_KEY=
# If YouTube says "Sign in to confirm you're not a bot":
# Prefer one-time export (browser can stay open afterwards):
#   cd backend && .\scripts\export_youtube_cookies.ps1
# YTDLP_COOKIES_FILE=./secrets/youtube_cookies.txt
# Or live browser (must fully quit browser while downloading):
# YTDLP_COOKIES_FROM_BROWSER=edge
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=

# Trend radar (YouTube Data API v3 — free quota)
YOUTUBE_API_KEY=
TRENDS_CACHE_HOURS=6
TRENDS_DEFAULT_REGION=RU
TRENDS_ANALYZE_COST_CREDITS=1
TIKTOK_TRENDS_ENABLED=true

# VideoGen Brain — structured rules for script/edit LLM prompts
BRAIN_ENABLED=true
BRAIN_MAX_RULES=12

# File Storage
MEDIA_ROOT=/workspace/media
UPLOAD_DIR=/workspace/media/uploads
GENERATED_DIR=/workspace/media/generated
