# AI Video Generator - Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/videogen
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/videogen

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# Admin Account
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme123

# AI API Keys (Required for production)
OPENAI_API_KEY=sk-your-openai-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
HEYGEN_API_KEY=your-heygen-api-key

# File Storage
MEDIA_ROOT=/workspace/media
UPLOAD_DIR=/workspace/media/uploads
GENERATED_DIR=/workspace/media/generated
