# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=videogen

# Application
ENVIRONMENT=production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-secure-secret-key-at-least-32-characters
# Cross-origin API access (leave empty unless a separate frontend domain calls
# this API directly — the bundled /admin and /dashboard panels are same-origin
# and don't need this). Comma-separated origins, e.g.:
# CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=

# Admin credentials
# Only seeds the admin row on a FRESH database. To rotate the password on an
# existing deployment, log in and call POST /api/v1/auth/change-password —
# editing this value later has no effect on an already-created admin user.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=your-secure-admin-password

# Queue: Celery is on by default in docker-compose (Postgres + Redis)
USE_CELERY=true

# AI API Keys (never commit real values)
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/
AITUNNEL_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

YOUTUBE_API_KEY=
TRENDS_CACHE_HOURS=6
TRENDS_DEFAULT_REGION=RU
TRENDS_ANALYZE_COST_CREDITS=1
TIKTOK_TRENDS_ENABLED=true

# Link ingest (optional Cobalt; yt-dlp is default in the app image)
LINK_INGEST_ENABLED=true
COBALT_API_URL=
COBALT_API_KEY=
# Mount cookies into the container and set path inside container, e.g. /workspace/secrets/youtube_cookies.txt
# Do NOT put cookies under MEDIA_ROOT (that used to be world-readable via /media).
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=

# VideoGen Brain (structured rules for LLM prompts)
BRAIN_ENABLED=true
BRAIN_MAX_RULES=12

# Payments — ЮKassa (self-serve token purchases): https://yookassa.ru
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Real https domain — used for the ЮKassa return_url after checkout
PUBLIC_BASE_URL=https://yourdomain.example.com
SELF_SERVE_FREE_CREDITS=3
