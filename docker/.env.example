# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=videogen

# Application
SECRET_KEY=your-very-secure-secret-key-at-least-32-characters

# Admin credentials
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=your-secure-admin-password

# Queue: Celery is on by default in docker-compose (Postgres + Redis)
USE_CELERY=true

# AI API Keys (never commit real values)
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/
AITUNNEL_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

YOUTUBE_API_KEY=
TRENDS_CACHE_HOURS=6
TRENDS_DEFAULT_REGION=RU
TRENDS_ANALYZE_COST_CREDITS=1
TIKTOK_TRENDS_ENABLED=true

# Link ingest (optional Cobalt; yt-dlp is default in the app image)
LINK_INGEST_ENABLED=true
COBALT_API_URL=
COBALT_API_KEY=
# Mount cookies into the container and set path inside container, e.g. /workspace/media/secrets/youtube_cookies.txt
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
